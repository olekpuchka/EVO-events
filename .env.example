# Copy to .env and fill in your values. .env is gitignored.

# Telegram bot token (from @BotFather)
BOT_TOKEN=

# FACEIT Data API key (https://developers.faceit.com)
FACEIT_API_KEY=

# DeepSeek API key — optional, for AI-generated hype/match phrases
# (bot falls back to built-in phrases if unset)
DEEPSEEK_API_KEY=

# DeepSeek model — optional, defaults to deepseek-v4-pro
# (deepseek-v4-flash is cheaper but noticeably blander)
DEEPSEEK_MODEL=

# How often to poll FACEIT for finished matches, in minutes — optional (default 20, min 5)
FACEIT_POLL_MINUTES=

# Bot language: EN or UA — optional (default EN)
LANGUAGE=

# Comma-separated Telegram user IDs whose typed event times are read as 🇪🇺 CET
# instead of 🇺🇦 Kyiv — optional (default: everyone is Kyiv)
EU_TIMEZONE_MEMBERS=

# SQLite location — optional, defaults to ./data (gitignored);
# set to /app/data in production, where a persistent volume is mounted
DATA_DIR=
