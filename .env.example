# Copy to .env and fill in your values. .env is gitignored.

# Telegram bot token (from @BotFather)
BOT_TOKEN=

# FACEIT Data API key (https://developers.faceit.com)
FACEIT_API_KEY=

# DeepSeek API key — optional, for AI-generated hype/match phrases
# (bot falls back to built-in phrases if unset)
DEEPSEEK_API_KEY=

# JustRunMy.App MCP — optional, lets an MCP-capable editor manage the
# deployment (logs, env vars, deploy). Get the X-User-Identity value from
# https://justrunmy.app/panel/mcp-tool-config
# Referenced by .mcp.json as ${JUSTRUNMYAPP_X_USER_IDENTITY}.
JUSTRUNMYAPP_X_USER_IDENTITY=
